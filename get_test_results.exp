#!/usr/bin/expect -f
set timeout 30
set password "eda2020"
set server "EDA@192.168.112.163"

spawn ssh -o StrictHostKeyChecking=no $server

expect "password:"
send "$password\r"

expect "$ "

# Get test output
send "cat /tmp/test_output.log\r"
expect "$ "

# Check tmux session
send "tmux ls\r"
expect "$ "

# Capture the tmux session directly
send "tmux capture-pane -t hipilot:0.0 -p -S -100 > /tmp/tmux_pane0.log\r"
expect "$ "

send "tmux capture-pane -t hipilot:0.1 -p -S -100 > /tmp/tmux_pane1.log\r"
expect "$ "

# Get screenshots with gnome-screenshot if available
send "which gnome-screenshot && gnome-screenshot -f /tmp/hipilot_gnome_\$(date +%Y%m%d_%H%M%S).png\r"
expect "$ "

send "ls -la /tmp/*.log /tmp/*.png 2>/dev/null\r"
expect "$ "

send "exit\r"
expect eof
