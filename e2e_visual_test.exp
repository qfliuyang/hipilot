#!/usr/bin/expect -f
# HiPilot Visual E2E Test on EDA Server
# Captures screenshot and screen recording as proof

set timeout 60
set password "eda2020"
set server "EDA@192.168.112.163"

# Start SSH session
spawn ssh -o StrictHostKeyChecking=no $server

expect "password:"
send "$password\r"

expect "$ "

# Set up environment
send "export PATH=/home/EDA/hipilot_test/node-v20.18.3-linux-x64-glibc-217/bin:\$PATH\r"
expect "$ "

send "export DISPLAY=:0\r"
expect "$ "

# Kill any existing tmux
send "pkill -u EDA tmux 2>/dev/null; sleep 1\r"
expect "$ "

# Create tmux session with split layout
send "tmux new-session -d -s hipilot -x 240 -y 60\r"
expect "$ "

send "tmux split-window -h -t hipilot:0\r"
expect "$ "

# Start Innovus in right pane
send "tmux send-keys -t hipilot:0.1 'innovus -nowin' Enter\r"
expect "$ "

sleep 5

# Start HiPilot status in left pane
send "tmux send-keys -t hipilot:0.0 'cd /home/EDA/hipilot_test/hipilot-latest && node bin/hipilot status' Enter\r"
expect "$ "

sleep 3

# Capture screenshot
send "import -window root /tmp/hipilot_e2e_\$(date +%Y%m%d_%H%M%S).png\r"
expect "$ "

# Now run the integration tests in a visible way
send "tmux send-keys -t hipilot:0.0 'clear' Enter\r"
expect "$ "

sleep 1

send "tmux send-keys -t hipilot:0.0 'cd /home/EDA/hipilot_test/hipilot-latest && npm test 2>&1 | tee /tmp/test_output.log' Enter\r"
expect "$ "

# Wait for tests to complete (up to 2 minutes)
sleep 30

# Capture another screenshot showing test results
send "tmux send-keys -t hipilot:0.0 'echo \"Tests complete - see /tmp/test_output.log\"' Enter\r"
expect "$ "

send "import -window root /tmp/hipilot_e2e_final_\$(date +%Y%m%d_%H%M%S).png\r"
expect "$ "

# Keep tmux session alive for visual inspection
send "echo 'E2E test complete. Screenshots saved to /tmp/hipilot_e2e_*.png'\r"
expect "$ "

# List the screenshots
send "ls -la /tmp/hipilot_e2e_*.png\r"
expect "$ "

# Exit SSH
send "exit\r"
expect eof
