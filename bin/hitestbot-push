#!/bin/bash
# HiTestBot Push — Upload files from dev machine to EDA server
#
# Usage:
#   bin/hitestbot-push skills/            # Push skills dir for quick iteration
#   bin/hitestbot-push deploy/eda-server/ # Push deploy config
#   bin/hitestbot-push test_plan.json     # Push specific file

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

SSH_HOST="${HIPILOT_SSH_HOST:-EDA@192.168.112.163}"
export SSHPASS="${SSHPASS:-${HIPILOT_SSH_PASS:-eda2020}}"
REMOTE_DIR="${HIPILOT_DEPLOY_DIR:-/home/EDA/hipilot/current}"
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10"

SRC="${1:-}"

if [ -z "$SRC" ]; then
  echo "Usage: bin/hitestbot-push <file-or-dir>"
  echo "  bin/hitestbot-push skills/            Push skills"
  echo "  bin/hitestbot-push deploy/eda-server/ Push deploy config"
  echo "Target: $SSH_HOST:$REMOTE_DIR/"
  exit 0
fi

SRC_ABS="$PROJECT_DIR/$SRC"
[ ! -e "$SRC_ABS" ] && SRC_ABS="$SRC"
[ ! -e "$SRC_ABS" ] && echo "Not found: $SRC" && exit 1

echo "Pushing $SRC to $SSH_HOST:$REMOTE_DIR/ ..."
if [ -d "$SRC_ABS" ]; then
  sshpass -e scp -r $SSH_OPTS "$SRC_ABS" "$SSH_HOST:$REMOTE_DIR/"
else
  sshpass -e scp $SSH_OPTS "$SRC_ABS" "$SSH_HOST:$REMOTE_DIR/"
fi
echo "Done."
