#!/bin/bash
# HiPilot Workspace Launcher - 5-Agent Team Mode (Default)
# Creates a tmux layout with 5 agent panes + 1 EDA pane
#
# 5-Agent Architecture:
# - Supervisor: Flow coordination and validation
# - Knowledge: Owns all 3 brains (ASIC + EDA + Project)
# - Planner: Queries Knowledge for execution strategy
# - Executor: Queries Knowledge for Tcl, executes via EDA MCP
# - Archivist: Records results to Knowledge (Project-Brain)
#
# Layout:
# ┌──────────┬──────────┬──────────┬──────────┐
# │Supervisor│Knowledge │ Planner  │ Executor │
# ├──────────┴──────────┴──────────┴──────────┤
# │           Archivist Agent                 │
# ├───────────────────────────────────────────┤
# │              EDA Tool Pane                │
# └───────────────────────────────────────────┘
#
# Usage:
#   bin/hipilot                  # Launch team workspace (default)
#   bin/hipilot --simple         # Launch simple 2-pane mode (legacy)
#   bin/hipilot --no-terminal    # Create session without opening new window

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

HIPILOT_TMPDIR="/tmp/hipilot-$(whoami)"
mkdir -p "$HIPILOT_TMPDIR"
mkdir -p "$HIPILOT_TMPDIR/exec"
mkdir -p "$HIPILOT_TMPDIR/generated"
mkdir -p "$HIPILOT_TMPDIR/agents"

HIPILOT_SESSION="${HIPILOT_SESSION:-hipilot}"

GREEN="\033[0;32m"
CYAN="\033[0;36m"
RED="\033[0;31m"
YELLOW="\033[1;33m"
NC="\033[0m"

NO_TERMINAL=false
SIMPLE_MODE=false
for arg in "$@"; do
  case $arg in
    --no-terminal) NO_TERMINAL=true ;;
    --simple) SIMPLE_MODE=true ;;
  esac
done

if ! command -v tmux &> /dev/null; then
    echo -e "${RED}Error: tmux not found.${NC}"
    exit 1
fi

# If simple mode requested, launch legacy 2-pane layout
if [ "$SIMPLE_MODE" = true ]; then
    exec "$SCRIPT_DIR/hipilot-simple" "$@"
fi

echo -e "${CYAN}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║   HiPilot v0.8.0 - VLSI Physical Design Copilot              ║"
echo "║   5-Agent Team Mode (Knowledge owns 3 Brains)                ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${NC}"

if tmux -L "$HIPILOT_SESSION" has-session 2>/dev/null; then
    echo -e "${GREEN}✓ HiPilot session already running${NC}"
    if [ "$NO_TERMINAL" = true ]; then
        echo "Attach with: tmux -L $HIPILOT_SESSION attach-session"
    else
        tmux -L "$HIPILOT_SESSION" attach-session
    fi
    exit 0
fi

echo -e "${GREEN}Creating HiPilot Team workspace...${NC}"
echo ""

# Create new session (detached) - start with supervisor pane
tmux -L "$HIPILOT_SESSION" new-session -d -s "$HIPILOT_SESSION" -n "HiPilot" -c "$PROJECT_DIR"

# Pass HIPILOT_DESIGN_DIR if set
if [ -n "$HIPILOT_DESIGN_DIR" ]; then
    tmux -L "$HIPILOT_SESSION" set-environment HIPILOT_DESIGN_DIR "$HIPILOT_DESIGN_DIR"
    echo "$HIPILOT_DESIGN_DIR" > "$HIPILOT_TMPDIR/design_dir.txt"
fi

# Build the 5-agent + 1 EDA layout
# Step 1: Split horizontally to create top row vs bottom section (EDA at bottom 35%)
tmux -L "$HIPILOT_SESSION" split-window -v -l 35% -c "$PROJECT_DIR"

# Step 2: In top section (pane 0), split into 4 columns (Supervisor | Knowledge | Planner | Executor)
tmux -L "$HIPILOT_SESSION" select-pane -t 0
tmux -L "$HIPILOT_SESSION" split-window -h -l 25% -c "$PROJECT_DIR"
tmux -L "$HIPILOT_SESSION" select-pane -t 0
tmux -L "$HIPILOT_SESSION" split-window -h -l 33% -c "$PROJECT_DIR"
tmux -L "$HIPILOT_SESSION" select-pane -t 0
tmux -L "$HIPILOT_SESSION" split-window -h -l 50% -c "$PROJECT_DIR"
# Now pane 0=Supervisor, pane 1=Knowledge, pane 2=Planner, pane 3=Executor, pane 4=bottom

# Step 3: In middle section (pane 4), keep as single Archivist pane
# Pane 4 is Archivist, Pane 5 is the remaining EDA section from Step 1
# Now pane 0=Supervisor, 1=Knowledge, 2=Planner, 3=Executor, 4=Archivist, 5=EDA

# Configure EDA pane (pane 5)
tmux -L "$HIPILOT_SESSION" set-option -t "$HIPILOT_SESSION:0.5" remain-on-exit on 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" set-option -t "$HIPILOT_SESSION:0.5" remain-on-exit-format " [EDA Ready] " 2>/dev/null || true

# Status bar for team mode
tmux -L "$HIPILOT_SESSION" set-option status on
tmux -L "$HIPILOT_SESSION" set-option status-interval 2
tmux -L "$HIPILOT_SESSION" set-option status-style "bg=#1a1a2e,fg=#e0e0e0"

tmux -L "$HIPILOT_SESSION" set-option status-left-length 80
tmux -L "$HIPILOT_SESSION" set-option status-left "\
#[fg=#00d4ff,bg=#1a1a2e,bold] ⚙ HiPilot #[fg=#666666]│\
#[fg=#ffd700,nobold] 👥 5 Agents #[fg=#666666]│"

tmux -L "$HIPILOT_SESSION" set-option status-right-length 60
tmux -L "$HIPILOT_SESSION" set-option status-right "\
#[fg=#666666]│#[fg=#00ff88] ▶ idle \
#[fg=#666666]│#[fg=#e0e0e0] design: —  "

tmux -L "$HIPILOT_SESSION" set-option status-justify centre
tmux -L "$HIPILOT_SESSION" set-option window-status-format " #W "
tmux -L "$HIPILOT_SESSION" set-option window-status-current-format "#[fg=#00d4ff,bold] #W "

tmux -L "$HIPILOT_SESSION" set-option pane-border-style "fg=#666666"
tmux -L "$HIPILOT_SESSION" set-option pane-active-border-style "fg=#00d4ff"
tmux -L "$HIPILOT_SESSION" set-option pane-border-status top 2>/dev/null || true

# Pane border labels
tmux -L "$HIPILOT_SESSION" set-option pane-border-format \
  "#{?#{==:#{pane_index},0},#[fg=#ff6b6b] 🎯 Supervisor ,\
   #{?#{==:#{pane_index},1},#[fg=#4ecdc4] 📚 Knowledge ,\
    #{?#{==:#{pane_index},2},#[fg=#95e1d3] 📋 Planner ,\
     #{?#{==:#{pane_index},3},#[fg=#f38181] ⚡ Executor ,\
      #{?#{==:#{pane_index},4},#[fg=#aa96da] 💾 Archivist ,\
        #[fg=#ffd93d] 🔧 EDA Tool }}}}" 2>/dev/null || true

# Setup each agent pane with initialization
setup_agent_pane() {
    local pane=$1
    local name=$2
    local emoji=$3
    local color=$4

    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" -l "clear"
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" C-m
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" -l "echo -e '\033[1;${color}m${emoji} ${name} Agent\033[0m'"
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" C-m
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" -l "echo '─────────────────────'"
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" C-m
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" -l "echo 'Status: Standby'"
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" C-m
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" -l "echo ''"
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" -l "echo 'Waiting for activation...'"
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" C-m
}

# Initialize all 5 agent panes
setup_agent_pane 0 "Supervisor" "🎯" "31"  # Red
setup_agent_pane 1 "Knowledge" "📚" "36"   # Cyan
setup_agent_pane 2 "Planner" "📋" "96"     # Light cyan
setup_agent_pane 3 "Executor" "⚡" "91"    # Light red
setup_agent_pane 4 "Archivist" "💾" "97"   # Light magenta

# Setup EDA pane (pane 5)
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" -l "clear"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" -l "echo -e '\033[1;33m🔧 EDA Tool Pane\033[0m'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" -l "echo '─────────────────────'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" -l "echo 'Ready for: innovus | dc_shell | pt_shell'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" C-m

# Keyboard shortcuts for switching between agent panes
tmux -L "$HIPILOT_SESSION" bind-key -n M-1 select-pane -t 0  # Alt+1: Supervisor
tmux -L "$HIPILOT_SESSION" bind-key -n M-2 select-pane -t 1  # Alt+2: Knowledge
tmux -L "$HIPILOT_SESSION" bind-key -n M-3 select-pane -t 2  # Alt+3: Planner
tmux -L "$HIPILOT_SESSION" bind-key -n M-4 select-pane -t 3  # Alt+4: Executor
tmux -L "$HIPILOT_SESSION" bind-key -n M-5 select-pane -t 4  # Alt+5: Archivist
tmux -L "$HIPILOT_SESSION" bind-key -n M-0 select-pane -t 5  # Alt+0: EDA Tool

# Sync mode toggle - broadcast to all agent panes
tmux -L "$HIPILOT_SESSION" bind-key b set-window-option synchronize-panes \; display-message "Sync mode toggled"

# Select supervisor pane by default
tmux -L "$HIPILOT_SESSION" select-pane -t 0

echo -e "${GREEN}✓ Team workspace created${NC}"
echo ""
echo "  Layout:"
echo "  ┌──────────────┬──────────────┬──────────────┬──────────────┐"
echo "  │ 🎯 Supervisor│ 📚 Knowledge │ 📋 Planner   │ ⚡ Executor  │"
echo "  ├──────────────┴──────────────┴──────────────┴──────────────┤"
echo "  │ 💾 Archivist Agent                                       │"
echo "  ├──────────────────────────────────────────────────────────┤"
echo "  │ 🔧 EDA Tool (innovus/dc_shell/pt_shell)                  │"
echo "  └──────────────────────────────────────────────────────────┘"
echo ""
echo "  Shortcuts:"
echo "    Alt+1-5   Switch to agent pane (1=Supervisor, 2=Knowledge, etc.)"
echo "    Alt+0     Switch to EDA pane"
echo "    prefix+b  Toggle broadcast mode (send to all panes)"
echo ""
echo "  Agent Architecture:"
echo "    Supervisor → coordinates flow phases"
echo "    Knowledge  → owns all 3 brains (ASIC + EDA + Project)"
echo "    Planner    → creates execution strategies"
echo "    Executor   → runs Tcl via EDA MCP"
echo "    Archivist  → records QoR and learnings"
echo ""

if [ "$NO_TERMINAL" = true ]; then
    echo "Attach with: tmux -L $HIPILOT_SESSION attach-session"
    exit 0
else
    tmux -L "$HIPILOT_SESSION" attach-session
fi
