#!/bin/bash
# HiPilot Workspace Launcher - Simple 2-Pane Mode (Legacy)
# Creates a 2-pane tmux layout: left=Claude Code, right=EDA Tool
# NO Team API - single Claude instance handles everything directly
#
# Layout:
# ┌───────────────────────────────┬───────────────────────────────┐
# │  Claude Code                  │  EDA Tool                     │
# │  (Single instance)            │  (Innovus/DC Shell/PT Shell)  │
# └───────────────────────────────┴───────────────────────────────┘
#
# Usage:
#   bin/hipilot-simple              # Launch simple workspace
#   bin/hipilot-simple --no-terminal # Create without opening window

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Add Node.js bin directory to PATH (for EDA server environment)
export PATH="/home/EDA/hipilot_test/node-v20.18.3-linux-x64-glibc-217/bin:$PATH"

# Find Claude CLI (npm installs it with random suffix like .claude-XXXXXXX)
CLAUDE_BIN=$(ls /home/EDA/hipilot_test/node-v20.18.3-linux-x64-glibc-217/bin/.claude-* 2>/dev/null | head -1)
if [ -z "$CLAUDE_BIN" ]; then
    # Fallback: try the cli.js directly
    CLAUDE_BIN="node /home/EDA/hipilot_test/node-v20.18.3-linux-x64-glibc-217/lib/node_modules/@anthropic-ai/claude-code/cli.js"
fi

HIPILOT_TMPDIR="/tmp/hipilot-$(whoami)"
mkdir -p "$HIPILOT_TMPDIR"

HIPILOT_SESSION="${HIPILOT_SESSION:-hipilot}"

GREEN="\033[0;32m"
CYAN="\033[0;36m"
RED="\033[0;31m"
YELLOW="\033[1;33m"
NC="\033[0m"

NO_TERMINAL=false
for arg in "$@"; do
  case $arg in
    --no-terminal) NO_TERMINAL=true ;;
  esac
done

if ! command -v tmux &> /dev/null; then
    echo -e "${RED}Error: tmux not found.${NC}"
    exit 1
fi

if [ ! -f "$CLAUDE_BIN" ] && [ ! -f "$(echo $CLAUDE_BIN | cut -d' ' -f2)" ]; then
    echo -e "${RED}Error: Claude CLI not found at $CLAUDE_BIN${NC}"
    exit 1
fi

if tmux -L "$HIPILOT_SESSION" has-session 2>/dev/null; then
    echo -e "${GREEN}Session already running${NC}"
    if [ "$NO_TERMINAL" = true ]; then
        echo "Attach: tmux -L $HIPILOT_SESSION attach-session"
    else
        tmux -L "$HIPILOT_SESSION" attach-session
    fi
    exit 0
fi

echo -e "${CYAN}"
echo "HiPilot v0.9.0 - Simple 2-Pane Mode (Legacy)"
echo -e "${NC}"

# Create new session with 2 panes
tmux -L "$HIPILOT_SESSION" new-session -d -s "$HIPILOT_SESSION" -n "HiPilot" -c "$PROJECT_DIR"
tmux -L "$HIPILOT_SESSION" split-window -h -t "$HIPILOT_SESSION" -l 50% -c "$PROJECT_DIR"

# Pass environment variables
if [ -n "$HIPILOT_DESIGN_DIR" ]; then
    tmux -L "$HIPILOT_SESSION" set-environment HIPILOT_DESIGN_DIR "$HIPILOT_DESIGN_DIR"
    echo "$HIPILOT_DESIGN_DIR" > "$HIPILOT_TMPDIR/design_dir.txt"
fi
tmux -L "$HIPILOT_SESSION" set-environment HIPILOT_SESSION "$HIPILOT_SESSION"
# NO TEAM MODE - single Claude instance
tmux -L "$HIPILOT_SESSION" set-environment HIPILOT_SIMPLE_MODE "1"

# Status bar
tmux -L "$HIPILOT_SESSION" set-option status on
tmux -L "$HIPILOT_SESSION" set-option status-interval 2
tmux -L "$HIPILOT_SESSION" set-option status-style "bg=#1a1a2e,fg=#e0e0e0"
tmux -L "$HIPILOT_SESSION" set-option status-left-length 80
tmux -L "$HIPILOT_SESSION" set-option status-left "#[fg=#00d4ff,bg=#1a1a2e,bold] ⚙ HiPilot #[fg=#666666]|#[fg=#00ff88,nobold] Simple Mode #[fg=#666666]|"
tmux -L "$HIPILOT_SESSION" set-option status-right-length 60
tmux -L "$HIPILOT_SESSION" set-option status-right "#[fg=#666666]|#[fg=#00ff88] ▶ idle #[fg=#666666]|#[fg=#e0e0e0] design: —"
tmux -L "$HIPILOT_SESSION" set-option status-justify centre

# Pane border labels
tmux -L "$HIPILOT_SESSION" set-option pane-border-style "fg=#666666"
tmux -L "$HIPILOT_SESSION" set-option pane-active-border-style "fg=#00d4ff"
tmux -L "$HIPILOT_SESSION" set-option pane-border-status top 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" set-option pane-border-format "#{?#{==:#{pane_index},0},#[fg=#00d4ff] Claude Code ,#[fg=#ffd93d] EDA Tool }" 2>/dev/null || true

# Launch Claude Code in left pane (Pane 0)
echo ""
echo -e "${CYAN}Launching HiPilot (Simple Mode)...${NC}"
echo -e "${YELLOW}  Single Claude instance - no team coordination${NC}"

tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" "clear" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" "export HIPILOT_AGENT_NAME='HiPilot'" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" "export HIPILOT_SIMPLE_MODE='1'" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" "$CLAUDE_BIN --dangerously-skip-permissions" C-m

# Setup EDA pane (pane 1) - just bash
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" "clear" C-m 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" "echo -e '\033[1;33m🔧 EDA Tool Pane\033[0m'" C-m 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" "echo 'Ready for: innovus | dc_shell | pt_shell'" C-m 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" "echo ''" C-m 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" "echo -e '\033[0;36mNote: This pane is controlled via MCP tools\033[0m'" C-m 2>/dev/null || true

# Keyboard shortcuts
tmux -L "$HIPILOT_SESSION" bind-key -n M-1 select-pane -t 0 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" bind-key -n M-2 select-pane -t 1 2>/dev/null || true

# Select left pane
tmux -L "$HIPILOT_SESSION" select-pane -t 0

echo ""
echo -e "${GREEN}HiPilot Simple Mode workspace created!${NC}"
echo ""
echo "  Layout:"
echo "  ┌───────────────────────────────┬───────────────────────────────┐"
echo "  │ 🎯 Claude Code                │ 🔧 EDA Tool Pane              │"
echo "  │    Pane 0                     │    Pane 1                     │"
echo "  │                               │                               │"
echo "  │  Single instance handles      │  Controlled via MCP           │"
echo "  │  all operations directly      │                               │"
echo "  └───────────────────────────────┴───────────────────────────────┘"
echo ""
echo "  Shortcuts: Alt+1/2 to switch panes"
echo ""

if [ "$NO_TERMINAL" = true ]; then
    echo "Attach: tmux -L $HIPILOT_SESSION attach-session"
    exit 0
else
    echo -e "${GREEN}Attaching to Claude Code pane...${NC}"
    sleep 3
    tmux -L "$HIPILOT_SESSION" attach-session
fi
