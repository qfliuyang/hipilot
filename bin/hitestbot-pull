#!/bin/bash
# HiTestBot Pull — Download test evidence from EDA server to dev machine
#
# Usage:
#   bin/hitestbot-pull                    # Pull latest evidence
#   bin/hitestbot-pull 20260226013000     # Pull specific timestamp
#   bin/hitestbot-pull --all              # Pull all evidence

set -e

SSH_HOST="${HIPILOT_SSH_HOST:-EDA@192.168.112.163}"
export SSHPASS="${SSHPASS:-${HIPILOT_SSH_PASS:-eda2020}}"
REMOTE_EVIDENCE="${HIPILOT_EVIDENCE_DIR:-/tmp/hipilot-test-evidence}"
LOCAL_EVIDENCE="${HITESTBOT_LOCAL_EVIDENCE:-test-evidence}"

TS="$1"
mkdir -p "$LOCAL_EVIDENCE"

SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10"

if [ "$TS" = "--all" ]; then
  echo "Pulling all evidence from $SSH_HOST:$REMOTE_EVIDENCE/ ..."
  sshpass -e scp -r $SSH_OPTS "$SSH_HOST:$REMOTE_EVIDENCE/" "$LOCAL_EVIDENCE/"
  echo "Done. Evidence in $LOCAL_EVIDENCE/"
elif [ -n "$TS" ]; then
  echo "Pulling $TS from $SSH_HOST ..."
  sshpass -e scp -r $SSH_OPTS "$SSH_HOST:$REMOTE_EVIDENCE/$TS" "$LOCAL_EVIDENCE/" || {
    echo "Not found at $REMOTE_EVIDENCE/$TS. Listing available:"
    sshpass -e ssh $SSH_OPTS "$SSH_HOST" "ls -la $REMOTE_EVIDENCE/ 2>/dev/null || echo 'No evidence dir'"
    exit 1
  }
  echo "Done. Evidence in $LOCAL_EVIDENCE/$TS/"
else
  echo "Pulling latest from $SSH_HOST ..."
  LATEST=$(sshpass -e ssh $SSH_OPTS "$SSH_HOST" "ls -t $REMOTE_EVIDENCE/ 2>/dev/null | head -1")
  if [ -z "$LATEST" ]; then
    echo "No evidence found. Run HiTestBot on EDA server first."
    exit 1
  fi
  echo "Latest: $LATEST"
  sshpass -e scp -r $SSH_OPTS "$SSH_HOST:$REMOTE_EVIDENCE/$LATEST" "$LOCAL_EVIDENCE/"
  # Create symlink to latest
  ln -sfn "$LATEST" "$LOCAL_EVIDENCE/latest"
  # Also pull MCP log for that test run
  sshpass -e scp $SSH_OPTS "$SSH_HOST:/tmp/hipilot_test_mcp.jsonl" "$LOCAL_EVIDENCE/$LATEST/mcp_log.jsonl" 2>/dev/null || true
  echo "Done. Evidence in $LOCAL_EVIDENCE/$LATEST/ (symlinked to $LOCAL_EVIDENCE/latest)"
fi
