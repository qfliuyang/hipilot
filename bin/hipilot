#!/bin/bash
# HiPilot Workspace Launcher
# Creates a tmux 50/50 split layout for Claude Code + EDA tool
# with status bar and keyboard shortcuts per UX specification
#
# Usage:
#   bin/hipilot                  # Launch workspace
#   bin/hipilot --no-terminal    # Create session without opening new window

set -e

# Auto-detect project root
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# User-specific temp directory (must match src/lib/paths.js)
HIPILOT_TMPDIR="/tmp/hipilot-$(whoami)"
mkdir -p "$HIPILOT_TMPDIR"
mkdir -p "$HIPILOT_TMPDIR/exec"
mkdir -p "$HIPILOT_TMPDIR/generated"

# Session name
HIPILOT_SESSION="${HIPILOT_SESSION:-hipilot}"

# Colors
GREEN="\033[0;32m"
CYAN="\033[0;36m"
RED="\033[0;31m"
YELLOW="\033[1;33m"
NC="\033[0m"

# Parse args
NO_TERMINAL=false
for arg in "$@"; do
  case $arg in
    --no-terminal) NO_TERMINAL=true ;;
  esac
done

# Check tmux
if ! command -v tmux &> /dev/null; then
    echo -e "${RED}Error: tmux not found.${NC}"
    echo "Install: apt install tmux  OR  brew install tmux"
    exit 1
fi

echo -e "${CYAN}"
echo "╔══════════════════════════════════════════════════════╗"
echo "║   HiPilot v0.7.0 - VLSI Physical Design Copilot    ║"
echo "╚══════════════════════════════════════════════════════╝"
echo -e "${NC}"

# Check if session already exists
if tmux -L "$HIPILOT_SESSION" has-session 2>/dev/null; then
    echo -e "${GREEN}✓ HiPilot session already running${NC}"

    if [ "$NO_TERMINAL" = true ]; then
        echo "Attach with: tmux -L $HIPILOT_SESSION attach-session"
    else
        tmux -L "$HIPILOT_SESSION" attach-session
    fi
    exit 0
fi

echo -e "${GREEN}Creating HiPilot workspace...${NC}"
echo ""

# Create new session with 50/50 split (detached)
tmux -L "$HIPILOT_SESSION" new-session -d -s "$HIPILOT_SESSION" -n "HiPilot" -c "$PROJECT_DIR"

# Split window 50/50
tmux -L "$HIPILOT_SESSION" split-window -h -l 50% -c "$PROJECT_DIR"

# -------------------------------------------------------------------
# Status Bar Configuration (UX Spec Section 5)
# Layout: | tool_section | skill_section | job_section | context_section |
# -------------------------------------------------------------------

# Status bar colors per UX spec (session-specific, not global)
tmux -L "$HIPILOT_SESSION" set-option status on
tmux -L "$HIPILOT_SESSION" set-option status-interval 5
tmux -L "$HIPILOT_SESSION" set-option status-style "bg=#1a1a2e,fg=#e0e0e0"

# Left status: Tool + Skill sections
tmux -L "$HIPILOT_SESSION" set-option status-left-length 60
tmux -L "$HIPILOT_SESSION" set-option status-left "\
#[fg=#00d4ff,bg=#1a1a2e,bold] ⚙ HiPilot #[fg=#666666]│\
#[fg=#ffd700,nobold] 📋 ready #[fg=#666666]│"

# Right status: Job + Context sections
tmux -L "$HIPILOT_SESSION" set-option status-right-length 60
tmux -L "$HIPILOT_SESSION" set-option status-right "\
#[fg=#666666]│#[fg=#00ff88] ▶ idle \
#[fg=#666666]│#[fg=#e0e0e0] design: —  "

# Window status (center)
tmux -L "$HIPILOT_SESSION" set-option status-justify centre
tmux -L "$HIPILOT_SESSION" set-option window-status-format " #W "
tmux -L "$HIPILOT_SESSION" set-option window-status-current-format "#[fg=#00d4ff,bold] #W "

# Pane borders
tmux -L "$HIPILOT_SESSION" set-option pane-border-style "fg=#666666"
tmux -L "$HIPILOT_SESSION" set-option pane-active-border-style "fg=#00d4ff"

# Pane border labels (if tmux supports it - 3.2+)
tmux -L "$HIPILOT_SESSION" set-option pane-border-status top 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" set-option pane-border-format \
  "#{?#{==:#{pane_index},0}, Chat (Claude Code) , EDA Terminal }" 2>/dev/null || true

# -------------------------------------------------------------------
# Keyboard Shortcuts (UX Spec Section 8) + Mode Management
# -------------------------------------------------------------------

# Mode is always auto — commands execute immediately
echo "auto" > $HIPILOT_TMPDIR/mode 2>/dev/null || true

# Ctrl+E: Switch focus to EDA pane (right)
tmux -L "$HIPILOT_SESSION" bind-key -n C-e select-pane -t "$HIPILOT_SESSION:0.1"

# Ctrl+H: Switch focus to Chat pane (left)
tmux -L "$HIPILOT_SESSION" bind-key h select-pane -t "$HIPILOT_SESSION:0.0"

# Ctrl+S: Save last generated Tcl
tmux -L "$HIPILOT_SESSION" bind-key -n C-s run-shell "mkdir -p $PROJECT_DIR/scripts && cp \$(ls -t $HIPILOT_TMPDIR/generated/*.tcl 2>/dev/null | head -1) $PROJECT_DIR/scripts/ 2>/dev/null && tmux -L $HIPILOT_SESSION display-message 'Saved to scripts/' || tmux -L $HIPILOT_SESSION display-message 'No generated Tcl to save'" 2>/dev/null || true

# Prefix+m: Toggle mode (manual <-> auto / "Claude has the conn")
# NOTE: Using prefix+m instead of Ctrl+M because Ctrl+M sends same byte as Enter!
tmux -L "$HIPILOT_SESSION" bind-key m run-shell "\
  MODE=\$(cat $HIPILOT_TMPDIR/mode 2>/dev/null || echo 'manual'); \
  if [ \"\$MODE\" = 'manual' ]; then \
    echo 'auto' > $HIPILOT_TMPDIR/mode; \
    tmux -L $HIPILOT_SESSION set-option -t $HIPILOT_SESSION status-left '#[fg=#000000,bg=#00ff88,bold] ⚡ Claude has conn #[default]'; \
    tmux -L $HIPILOT_SESSION display-message '⚡ Claude has the conn (auto mode)'; \
  else \
    echo 'manual' > $HIPILOT_TMPDIR/mode; \
    tmux -L $HIPILOT_SESSION set-option -t $HIPILOT_SESSION status-left '#[fg=#00d4ff,bg=#1a1a2e,bold] ⚙ HiPilot #[fg=#666666]│#[fg=#ffd700] 🔒 Manual '; \
    tmux -L $HIPILOT_SESSION display-message '🔒 Manual mode (approval required)'; \
  fi" 2>/dev/null || true

# Prefix+y (yes): Approve pending Tcl and execute
tmux -L "$HIPILOT_SESSION" bind-key y run-shell "\
  if [ -f $HIPILOT_TMPDIR/pending.tcl ]; then \
    TMPFILE=$HIPILOT_TMPDIR/exec/exec_\$(date +%s).tcl; \
    cp $HIPILOT_TMPDIR/pending.tcl \$TMPFILE; \
    rm -f $HIPILOT_TMPDIR/pending.tcl $HIPILOT_TMPDIR/pending_meta.json; \
    tmux -L $HIPILOT_SESSION send-keys -t $HIPILOT_SESSION:0.1 -l \"source \$TMPFILE\"; \
    tmux -L $HIPILOT_SESSION send-keys -t $HIPILOT_SESSION:0.1 C-m; \
    tmux -L $HIPILOT_SESSION display-message '✓ Approved and executed pending Tcl'; \
  else \
    tmux -L $HIPILOT_SESSION display-message 'No pending Tcl to approve'; \
  fi" 2>/dev/null || true

# Prefix+n (no): Reject pending Tcl
tmux -L "$HIPILOT_SESSION" bind-key n run-shell "\
  if [ -f $HIPILOT_TMPDIR/pending.tcl ]; then \
    rm -f $HIPILOT_TMPDIR/pending.tcl $HIPILOT_TMPDIR/pending_meta.json; \
    tmux -L $HIPILOT_SESSION display-message '✗ Pending Tcl rejected'; \
  else \
    tmux -L $HIPILOT_SESSION display-message 'No pending Tcl to reject'; \
  fi" 2>/dev/null || true

# Prefix+r: Refresh status bar
tmux -L "$HIPILOT_SESSION" bind-key r run-shell "tmux -L $HIPILOT_SESSION display-message 'Status refreshed'" 2>/dev/null || true

# Prefix+M (shift+m): Show mode status
tmux -L "$HIPILOT_SESSION" bind-key M run-shell "\
  MODE=\$(cat $HIPILOT_TMPDIR/mode 2>/dev/null || echo 'manual'); \
  if [ \"\$MODE\" = 'auto' ]; then \
    tmux -L $HIPILOT_SESSION display-message '⚡ AUTO: Claude has the conn - commands execute immediately'; \
  else \
    PENDING=''; \
    if [ -f $HIPILOT_TMPDIR/pending.tcl ]; then \
      LINES=\$(wc -l < $HIPILOT_TMPDIR/pending.tcl); \
      PENDING=\" - \$LINES lines pending\"; \
    fi; \
    tmux -L $HIPILOT_SESSION display-message \"🔒 MANUAL: Approval required\$PENDING\"; \
  fi" 2>/dev/null || true

# -------------------------------------------------------------------
# Pane setup
# -------------------------------------------------------------------

# Setup left pane (Chat)
# Note: Do NOT clear the pane here - it would erase the trust prompt

if command -v claude >/dev/null 2>&1; then
  # Auto-start Claude Code with MCP permissions in the chat pane
  # Use --mcp-config to force-load MCP servers (bypasses feature gate)
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" -l "claude --mcp-config /tmp/force_mcp.json --strict-mcp-config --dangerously-skip-permissions"
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
  # Wait for Claude to start and acknowledge the trust prompt
  # Poll for up to 30 seconds until the trust prompt appears, then send "1"
  echo "Waiting for Claude Code to initialize..."
  TRUST_HANDLED=false
  for i in $(seq 1 60); do
    sleep 0.5
    CAPTURE=$(tmux -L "$HIPILOT_SESSION" capture-pane -t "$HIPILOT_SESSION:0.0" -p 2>/dev/null || true)
    # Capture pane content and check for trust prompt
    if echo "$CAPTURE" | grep -q "Quick safety check"; then
      sleep 0.5
      tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" -l "1"
      tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
      echo "Trust prompt acknowledged."
      TRUST_HANDLED=true
      break
    fi
    # Check for bypass permissions prompt (can appear instead of trust prompt in v2.1.59+)
    if echo "$CAPTURE" | grep -qE "(bypass permissions|Dangerous mode|⏵⏵)"; then
      echo "Bypass permissions prompt detected early, will handle in next step..."
      break
    fi
    # Also break if we see the welcome screen (trust was already acknowledged or bypassed)
    if echo "$CAPTURE" | grep -q "Welcome back"; then
      echo "Claude Code initialized."
      TRUST_HANDLED=true
      break
    fi
  done

  # Handle "bypass permissions" prompt (appears with --dangerously-skip-permissions)
  # This prompt appears after the trust prompt and requires user interaction to enable
  # dangerous tool permissions. We need to check the checkbox and confirm.
  # Check for up to 20 seconds - this prompt can appear late
  echo "Checking for bypass permissions prompt..."
  BYPASS_HANDLED=false
  for i in $(seq 1 40); do
    sleep 0.5
    CAPTURE=$(tmux -L "$HIPILOT_SESSION" capture-pane -t "$HIPILOT_SESSION:0.0" -p 2>/dev/null || true)
    # Check for bypass permissions prompt (various forms)
    # Note: Claude Code v2.1.59+ uses numbered list: "1. No, exit" / "2. Yes, I accept"
    if echo "$CAPTURE" | grep -qE "(bypass permissions|Dangerous mode|Yes, I accept|Enter to confirm)"; then
      echo "Bypass permissions prompt detected (attempt $i), enabling..."
      sleep 0.5

      # Ensure pane 0.0 is focused before sending keys (gnome-terminal may attach with wrong focus)
      tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
      sleep 0.1

      # Check if it's a numbered list interface (newer Claude versions)
      # Note: grep -z allows matching across lines, or check for unique "Yes, I accept" text
      if echo "$CAPTURE" | grep -qE "2\.\s*Yes, I accept"; then
        echo "Detected numbered list interface, selecting option 2 (Yes)..."
        tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
        tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" "2"
        sleep 0.2
        tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
        tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
      else
        # Fallback: Try checkbox interface (older approach)
        echo "Trying checkbox interface..."
        tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
        tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" Tab
        sleep 0.2
        tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
        tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" " "
        sleep 0.2
        tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
        tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
      fi
      sleep 0.5

      # Check if it worked by looking for the welcome screen
      CAPTURE2=$(tmux -L "$HIPILOT_SESSION" capture-pane -t "$HIPILOT_SESSION:0.0" -p 2>/dev/null || true)
      if echo "$CAPTURE2" | grep -q "Welcome back"; then
        echo "Bypass permissions enabled successfully."
        BYPASS_HANDLED=true
        break
      fi

      # If still showing prompt with numbered list, retry with explicit 2+Enter
      if echo "$CAPTURE2" | grep -qE "(1\.\s*No|2\.\s*Yes)"; then
        echo "Retrying with explicit selection..."
        tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
        tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" "2"
        sleep 0.2
        tmux -L "$HIPILOT_SESSION" select-pane -t "$HIPILOT_SESSION:0.0"
        tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
        sleep 0.5
        CAPTURE3=$(tmux -L "$HIPILOT_SESSION" capture-pane -t "$HIPILOT_SESSION:0.0" -p 2>/dev/null || true)
        if echo "$CAPTURE3" | grep -q "Welcome back"; then
          echo "Bypass permissions enabled successfully (retry)."
          BYPASS_HANDLED=true
          break
        fi
      fi

      if echo "$CAPTURE2" | grep -qE "(bypass permissions|Dangerous mode)"; then
        echo "WARNING: Bypass prompt still showing after attempts."
      fi
    fi
    # If we see the welcome screen, permissions are already handled
    if echo "$CAPTURE" | grep -q "Welcome back"; then
      echo "Claude Code initialized (permissions already handled)."
      BYPASS_HANDLED=true
      break
    fi
  done
  if [ "$BYPASS_HANDLED" = false ]; then
    echo "Warning: Bypass permissions prompt handling timed out."
  fi

  # CRITICAL: Wait for Claude Code to fully initialize MCP servers
  # This prevents "MCP tools not available" errors when commands are typed too quickly
  # Note: HiTestBot also polls for readiness, so we just need a minimum viable wait
  echo "Waiting for Claude Code MCP servers to initialize..."
  MCP_READY=false
  # Poll for up to 20 seconds (40 * 0.5s) - balances readiness with timeout limits
  for i in $(seq 1 40); do
    sleep 0.5
    # Check for the input prompt (❯ or >) which indicates Claude is ready
    if tmux -L "$HIPILOT_SESSION" capture-pane -t "$HIPILOT_SESSION:0.0" -p 2>/dev/null | grep -Eq "(❯|> )$"; then
      MCP_READY=true
      echo "Claude Code ready."
      break
    fi
    # Also accept if we see the idle state indicator
    if tmux -L "$HIPILOT_SESSION" capture-pane -t "$HIPILOT_SESSION:0.0" -p 2>/dev/null | grep -q "Now chatting"; then
      MCP_READY=true
      echo "Claude Code ready."
      break
    fi
  done

  if [ "$MCP_READY" = false ]; then
    echo "Warning: Claude Code may not be fully initialized (MCP servers still loading)."
    echo "HiTestBot will handle additional waiting as needed."
  fi
else
  # Fallback instructions if claude CLI is not available
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" -l "echo '  HiPilot Chat Pane'"
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" -l "echo '  ─────────────────'"
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" -l "echo ''"
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" -l "echo '  Claude CLI not found in PATH.'"
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" -l "echo '  Install Claude, then run: claude --dangerously-skip-permissions'"
  tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.0" C-m
fi

# Setup right pane (EDA) - show welcome
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "clear"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '  EDA Tool Pane'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '  ──────────────'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '  Start your EDA tool:'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '    icc2_shell    (Synopsys ICC2)'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '    innovus       (Cadence Innovus)'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '    pt_shell      (Synopsys PrimeTime)'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo ''"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '  🔒 Manual mode active (default)'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" -l "echo '  HiPilot Tcl commands require approval.'"
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.1" C-m
# Select left pane (chat) as default focus
tmux -L "$HIPILOT_SESSION" select-pane -t 0

echo -e "${GREEN}✓ Workspace created${NC}"
echo ""
echo "  Layout:"
echo "  ┌──────────────────────┬──────────────────────┐"
echo "  │ Pane 0: Chat (50%)   │ Pane 1: EDA (50%)    │"
echo "  │ Claude Code          │ icc2_shell / innovus │"
echo "  ├──────────────────────┴──────────────────────┤"
echo "  │ Status Bar: HiPilot │ Tool │ Job │ Design   │"
echo "  └─────────────────────────────────────────────┘"
echo ""
  echo "  Commands execute immediately (no approval needed)."
  echo ""
  echo "  Shortcuts:"
  echo "    Ctrl+E    Switch to EDA pane"
  echo "    Ctrl+S    Save last generated Tcl"
  echo "    prefix+h  Switch to Chat pane"
echo ""

if [ "$NO_TERMINAL" = true ]; then
    echo "Attach with: tmux -L $HIPILOT_SESSION attach-session"
    exit 0
else
    tmux -L "$HIPILOT_SESSION" attach-session
fi
