#!/bin/bash
# HiPilot Workspace Launcher - True 5-Agent Team Mode
# Creates a tmux layout with 5 Claude Code agent instances + 1 EDA pane
#
# Architecture:
# - Pane 0 (Supervisor): Main user interface, coordinates all agents
# - Pane 1 (Knowledge): Brain hub, handles 3-brain queries
# - Pane 2 (Planner): Strategy agent
# - Pane 3 (Executor): Tcl execution agent
# - Pane 4 (Archivist): Recording agent
# - Pane 5 (EDA): EDA tool terminal
#
# Each agent runs a real Claude Code instance with specialized identity.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

HIPILOT_TMPDIR="/tmp/hipilot-$(whoami)"
mkdir -p "$HIPILOT_TMPDIR"
mkdir -p "$HIPILOT_TMPDIR/exec"
mkdir -p "$HIPILOT_TMPDIR/agents"
mkdir -p "$HIPILOT_TMPDIR/agent-logs"

HIPILOT_SESSION="${HIPILOT_SESSION:-hipilot}"

GREEN="\033[0;32m"
CYAN="\033[0;36m"
RED="\033[0;31m"
YELLOW="\033[1;33m"
NC="\033[0m"

NO_TERMINAL=false
SIMPLE_MODE=false
for arg in "$@"; do
  case $arg in
    --no-terminal) NO_TERMINAL=true ;;
    --simple) SIMPLE_MODE=true ;;
  esac
done

if ! command -v tmux &> /dev/null; then
    echo -e "${RED}Error: tmux not found.${NC}"
    exit 1
fi

# If simple mode requested, launch legacy 2-pane layout
if [ "$SIMPLE_MODE" = true ]; then
    exec "$SCRIPT_DIR/hipilot-simple" "$@"
fi

echo -e "${CYAN}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║   HiPilot v0.8.0 - VLSI Physical Design Copilot              ║"
echo "║   TRUE 5-Agent Team Mode (5 Claude instances)                ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${NC}"

# Check if claude CLI is available
if ! command -v claude &> /dev/null; then
    echo -e "${RED}Error: Claude CLI not found. Install with: npm install -g @anthropic-ai/claude-code${NC}"
    exit 1
fi

if tmux -L "$HIPILOT_SESSION" has-session 2>/dev/null; then
    echo -e "${GREEN}✓ HiPilot session already running${NC}"
    if [ "$NO_TERMINAL" = true ]; then
        echo "Attach with: tmux -L $HIPILOT_SESSION attach-session"
    else
        tmux -L "$HIPILOT_SESSION" attach-session
    fi
    exit 0
fi

echo -e "${GREEN}Creating TRUE 5-Agent Team workspace...${NC}"
echo "  This will launch 5 Claude Code instances (one per agent)"
echo ""

# Create agent identity CLAUDE.md files
create_agent_identity() {
    local agent_name=$1
    local agent_role=$2
    local agent_desc=$3
    local agent_duties=$4

    cat > "$HIPILOT_TMPDIR/agents/${agent_name}-CLAUDE.md" << EOF
# You Are HiPilot - ${agent_name} Agent

**Identity:** You are the **${agent_name}** agent in HiPilot's 5-Agent Team.

**Your Role:** ${agent_role}

**Your Duties:**
${agent_duties}

## Team Communication

You communicate with other agents via the Knowledge Agent (hub-and-spoke pattern):
- **NEVER** talk directly to other agents
- **ALWAYS** query Knowledge Agent for information
- Knowledge Agent owns all 3 brains (ASIC-Brain, EDA-Brain, Project-Brain)

## Your Pane

You are running in tmux pane: ${agent_name}
Your socket: $HIPILOT_SESSION

## Available Tools

You have access to:
- MCP servers (eda, tmux, knowledge)
- 3-Brain system via Knowledge Agent
- Skills directory

## When Activated

Wait for Supervisor to assign tasks. Do not act until instructed.
EOF
}

# Create identities for all 5 agents
create_agent_identity "Supervisor" \
    "Team Coordinator" \
    "- Validate prerequisites for each flow phase
- Coordinate agent activities
- Communicate with the human engineer
- Make go/no-go decisions
- Handle errors and recovery" \
    "You are in Pane 0. The human engineer interacts with you."

create_agent_identity "Knowledge" \
    "Brain Hub (3-Brain Owner)" \
    "- Own ASIC-Brain (Tcl patterns, flow orchestration)
- Own EDA-Brain (tool commands, error patterns)
- Own Project-Brain (design memory, QoR history)
- Answer queries from other agents
- Provide context-aware knowledge" \
    "You are in Pane 1. All agents query you for information."

create_agent_identity "Planner" \
    "Strategy Agent" \
    "- Query Knowledge for flow definitions
- Create execution plans
- Determine stage sequences
- Estimate effort and timing
- Identify risks and contingencies" \
    "You are in Pane 2. Supervisor assigns planning tasks to you."

create_agent_identity "Executor" \
    "Operations Agent" \
    "- Get Tcl from Knowledge Agent
- Execute via EDA MCP
- Monitor tool output
- Handle execution errors
- Report completion status" \
    "You are in Pane 3. Supervisor/Planner assign execution tasks to you."

create_agent_identity "Archivist" \
    "Recorder Agent" \
    "- Record QoR metrics to Project-Brain
- Store error patterns and learnings
- Analyze QoR trends
- Generate reports
- Maintain design history" \
    "You are in Pane 4. All agents send you data to record."

# Create new session (detached) - start with supervisor pane
tmux -L "$HIPILOT_SESSION" new-session -d -s "$HIPILOT_SESSION" -n "HiPilot" -c "$PROJECT_DIR"

# Pass environment variables
if [ -n "$HIPILOT_DESIGN_DIR" ]; then
    tmux -L "$HIPILOT_SESSION" set-environment HIPILOT_DESIGN_DIR "$HIPILOT_DESIGN_DIR"
    echo "$HIPILOT_DESIGN_DIR" > "$HIPILOT_TMPDIR/design_dir.txt"
fi
tmux -L "$HIPILOT_SESSION" set-environment HIPILOT_SESSION "$HIPILOT_SESSION"

# Build the 5-agent + 1 EDA layout (6 panes total)
# Target layout:
# ┌─────┬─────┬─────┬─────┐
# │  0  │  1  │  2  │  3  │  <- Top row: Supervisor, Knowledge, Planner, Executor
# ├─────┴─────┴─────┴─────┤
# │           4           │  <- Middle: Archivist
# ├───────────────────────┤
# │           5           │  <- Bottom: EDA
# └───────────────────────┘

# Step 1: Split into top (65%) and bottom (35%) - pane 0 and pane 1
tmux -L "$HIPILOT_SESSION" split-window -v -l 35% -c "$PROJECT_DIR"

# Step 2: Split bottom pane (pane 1) into Archivist (top) and EDA (bottom)
# After this: pane 0=top, pane 1=middle, pane 2=bottom
tmux -L "$HIPILOT_SESSION" select-pane -t 1
tmux -L "$HIPILOT_SESSION" split-window -v -l 50% -c "$PROJECT_DIR"

# Step 3: Split top pane (pane 0) into 4 columns
# First split creates pane 0 and pane 1, pushing others down
tmux -L "$HIPILOT_SESSION" select-pane -t 0
tmux -L "$HIPILOT_SESSION" split-window -h -l 25% -c "$PROJECT_DIR"

# Second split on pane 0
tmux -L "$HIPILOT_SESSION" select-pane -t 0
tmux -L "$HIPILOT_SESSION" split-window -h -l 33% -c "$PROJECT_DIR"

# Third split on pane 0 - now we have 4 panes in top row
tmux -L "$HIPILOT_SESSION" select-pane -t 0
tmux -L "$HIPILOT_SESSION" split-window -h -l 50% -c "$PROJECT_DIR"

# Final layout: 0=Supervisor, 1=Knowledge, 2=Planner, 3=Executor, 4=Archivist, 5=EDA

# Status bar
tmux -L "$HIPILOT_SESSION" set-option status on
tmux -L "$HIPILOT_SESSION" set-option status-interval 2
tmux -L "$HIPILOT_SESSION" set-option status-style "bg=#1a1a2e,fg=#e0e0e0"
tmux -L "$HIPILOT_SESSION" set-option status-left-length 80
tmux -L "$HIPILOT_SESSION" set-option status-left "#[fg=#00d4ff,bg=#1a1a2e,bold] ⚙ HiPilot #[fg=#666666]|#[fg=#ffd700,nobold] 🎯 5 Agents #[fg=#666666]|"
tmux -L "$HIPILOT_SESSION" set-option status-right-length 60
tmux -L "$HIPILOT_SESSION" set-option status-right "#[fg=#666666]|#[fg=#00ff88] ▶ idle #[fg=#666666]|#[fg=#e0e0e0] design: —"
tmux -L "$HIPILOT_SESSION" set-option status-justify centre

# Pane border labels
tmux -L "$HIPILOT_SESSION" set-option pane-border-style "fg=#666666"
tmux -L "$HIPILOT_SESSION" set-option pane-active-border-style "fg=#00d4ff"
tmux -L "$HIPILOT_SESSION" set-option pane-border-status top 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" set-option pane-border-format "#{?#{==:#{pane_index},0},#[fg=#ff6b6b] 🎯 Supervisor ,#{?#{==:#{pane_index},1},#[fg=#4ecdc4] 📚 Knowledge ,#{?#{==:#{pane_index},2},#[fg=#95e1d3] 📋 Planner ,#{?#{==:#{pane_index},3},#[fg=#f38181] ⚡ Executor ,#{?#{==:#{pane_index},4},#[fg=#aa96da] 💾 Archivist ,#[fg=#ffd93d] 🔧 EDA Tool }}}}" 2>/dev/null || true

# Launch Claude Code in each agent pane
launch_claude_agent() {
    local pane=$1
    local name=$2
    local identity_file="$HIPILOT_TMPDIR/agents/${name}-CLAUDE.md"
    local log_file="$HIPILOT_TMPDIR/agent-logs/${name}.log"

    echo -e "${YELLOW}  Launching ${name} Agent (pane ${pane})...${NC}"

    # Clear pane and set up environment
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" "clear" C-m
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" "export HIPILOT_AGENT_NAME='${name}'" C-m
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" "export HIPILOT_AGENT_PANE='${pane}'" C-m

    # Copy identity to current dir for this agent session
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" "cp '${identity_file}' ./CLAUDE.md" C-m

    # Launch Claude Code with identity
    # Use nohup to keep running even if pane loses focus
    tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.$pane" \
        "claude --dangerously-skip-permissions" C-m
}

# Launch all 5 agent Clauses
echo ""
echo -e "${CYAN}Launching 5 Claude Code instances...${NC}"
launch_claude_agent 0 "Supervisor"
sleep 2
launch_claude_agent 1 "Knowledge"
sleep 2
launch_claude_agent 2 "Planner"
sleep 2
launch_claude_agent 3 "Executor"
sleep 2
launch_claude_agent 4 "Archivist"

# Wait for layout to settle and verify panes exist
sleep 1
PANE_COUNT=$(tmux -L "$HIPILOT_SESSION" list-panes | wc -l)
if [ "$PANE_COUNT" -lt 6 ]; then
    echo -e "${RED}Error: Expected 6 panes, found $PANE_COUNT${NC}"
    tmux -L "$HIPILOT_SESSION" kill-session
    exit 1
fi

# Setup EDA pane (pane 5) - just bash, no Claude
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" "clear" C-m 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" "echo -e '\033[1;33m🔧 EDA Tool Pane\033[0m'" C-m 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" "echo 'Ready for: innovus | dc_shell | pt_shell'" C-m 2>/dev/null || true
tmux -L "$HIPILOT_SESSION" send-keys -t "$HIPILOT_SESSION:0.5" "echo ''" C-m 2>/dev/null || true

# Keyboard shortcuts
tmux -L "$HIPILOT_SESSION" bind-key -n M-1 select-pane -t 0
tmux -L "$HIPILOT_SESSION" bind-key -n M-2 select-pane -t 1
tmux -L "$HIPILOT_SESSION" bind-key -n M-3 select-pane -t 2
tmux -L "$HIPILOT_SESSION" bind-key -n M-4 select-pane -t 3
tmux -L "$HIPILOT_SESSION" bind-key -n M-5 select-pane -t 4
tmux -L "$HIPILOT_SESSION" bind-key -n M-0 select-pane -t 5

# Select supervisor pane
tmux -L "$HIPILOT_SESSION" select-pane -t 0

echo ""
echo -e "${GREEN}✓ TRUE 5-Agent Team workspace created${NC}"
echo ""
echo "  Layout:"
echo "  ┌──────────────┬──────────────┬──────────────┬──────────────┐"
echo "  │ 🎯 Supervisor│ 📚 Knowledge │ 📋 Planner   │ ⚡ Executor  │"
echo "  │   (Claude)   │   (Claude)   │   (Claude)   │   (Claude)   │"
echo "  ├──────────────┴──────────────┴──────────────┴──────────────┤"
echo "  │ 💾 Archivist Agent (Claude)                              │"
echo "  ├──────────────────────────────────────────────────────────┤"
echo "  │ 🔧 EDA Tool (innovus/dc_shell/pt_shell)                  │"
echo "  └──────────────────────────────────────────────────────────┘"
echo ""
echo "  Shortcuts:"
echo "    Alt+1-5   Switch to agent pane"
echo "    Alt+0     Switch to EDA pane"
echo ""
echo "  IMPORTANT: Wait 10-15 seconds for all Claude instances to initialize"
echo ""

if [ "$NO_TERMINAL" = true ]; then
    echo "Attach with: tmux -L $HIPILOT_SESSION attach-session"
    exit 0
else
    echo -e "${GREEN}Attaching to Supervisor pane...${NC}"
    sleep 3
    tmux -L "$HIPILOT_SESSION" attach-session
fi
