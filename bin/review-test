#!/bin/bash
# Test Review Board CLI — Independent third-party verification of HiTestBot results
#
# Usage:
#   bin/review-test <evidence-directory>     # Review specific evidence directory
#   bin/review-test latest                   # Review most recent test evidence
#   bin/review-test --help                   # Show help

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Colors for output
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
CYAN="\033[0;36m"
NC="\033[0m"

show_help() {
    echo -e "${CYAN}HiPilot Test Review Board — Independent Verification${NC}"
    echo ""
    echo "Usage:"
    echo "  bin/review-test <evidence-directory>  Review specific test evidence"
    echo "  bin/review-test latest                Review most recent test"
    echo "  bin/review-test --help                Show this help"
    echo ""
    echo "The Review Board is a standalone third party that:"
    echo "  1. Reads evidence files independently (no trust in HiTestBot)"
    echo "  2. Re-implements scoring logic (separate from HiTestBot)"
    echo "  3. Detects mismatches between claims and actual evidence"
    echo "  4. Provides authoritative final assessment"
    echo ""
    echo "Exit codes:"
    echo "  0  Test approved (score >= 5.0/10)"
    echo "  1  Test failed or review error"
    echo ""
    echo "Evidence directories are typically:"
    echo "  test-evidence/YYYYMMDD_HHMMSS/"
}

# Parse arguments
EVIDENCE_DIR="$1"

if [ -z "$EVIDENCE_DIR" ] || [ "$EVIDENCE_DIR" = "--help" ] || [ "$EVIDENCE_DIR" = "-h" ]; then
    show_help
    exit 0
fi

# Handle "latest" keyword
if [ "$EVIDENCE_DIR" = "latest" ]; then
    LATEST_DIR=$(find "${PROJECT_DIR}/test-evidence" -maxdepth 1 -type d -name "20*" 2>/dev/null | sort -r | head -1)

    if [ -z "$LATEST_DIR" ]; then
        # Try alternative location
        LATEST_DIR=$(find "${PROJECT_DIR}/test-evidence-phase3-4" -maxdepth 1 -type d -name "20*" 2>/dev/null | sort -r | head -1)
    fi

    if [ -z "$LATEST_DIR" ]; then
        echo -e "${RED}Error: No evidence directories found${NC}"
        exit 1
    fi

    EVIDENCE_DIR="$LATEST_DIR"
    echo -e "${CYAN}Reviewing latest test evidence:${NC}"
    echo "  $EVIDENCE_DIR"
    echo ""
fi

# Verify evidence directory exists
if [ ! -d "$EVIDENCE_DIR" ]; then
    # Try relative to project root
    if [ -d "${PROJECT_DIR}/${EVIDENCE_DIR}" ]; then
        EVIDENCE_DIR="${PROJECT_DIR}/${EVIDENCE_DIR}"
    else
        echo -e "${RED}Error: Evidence directory not found: $EVIDENCE_DIR${NC}"
        exit 1
    fi
fi

# Run the Review Board
echo -e "${CYAN}Starting Test Review Board...${NC}"
echo ""

cd "$PROJECT_DIR"
node src/hitestbot/core/TestReviewBoard.js "$EVIDENCE_DIR"

EXIT_CODE=$?

echo ""
if [ $EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}✓ Review completed — test approved${NC}"
else
    echo -e "${RED}✗ Review completed — test failed or disputed${NC}"
fi

exit $EXIT_CODE
