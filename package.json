{
  "name": "hipilot",
  "version": "0.5.0",
  "description": "VLSI Physical Design Copilot - AI assistant for EDA engineers. Generate Tcl scripts, control EDA tools, and manage RTL-to-GDS flows with Claude Code.",
  "main": "src/index.js",
  "bin": {
    "hipilot": "./src/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "hipilot": "node src/index.js",
    "tui": "node src/cli.js",
    "setup": "bash bin/setup.sh",
    "postinstall": "node scripts/postinstall.js",
    "install:all": "npm install && cd servers/eda && npm install && cd ../tmux && npm install && cd ../knowledge && npm install",
    "dev:eda": "node servers/eda/index.js",
    "dev:tmux": "node servers/tmux/index.js",
    "dev:knowledge": "node servers/knowledge/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "test:coverage": "vitest run --coverage",
    "hitestbot": "node src/hitestbot/index.js",
    "prepublishOnly": "npm run install:all"
  },
  "keywords": [
    "hipilot",
    "vlsi",
    "physical-design",
    "eda",
    "copilot",
    "mcp",
    "synopsys",
    "cadence",
    "timing",
    "tcl",
    "innovus",
    "icc2",
    "primetime",
    "design-compiler",
    "rtl-to-gds",
    "chip-design",
    "semiconductor"
  ],
  "author": "HiPilot Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^9.5.0",
    "ink": "^6.8.0",
    "ink-big-text": "^2.0.0",
    "ink-box": "^1.0.0",
    "ink-gradient": "^4.0.0",
    "ink-progress-bar": "^3.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "nunjucks": "^3.2.4",
    "ora": "^6.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "vitest": "^1.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "servers/",
    "skills/",
    "scripts/",
    "templates/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "directories": {
    "bin": "./bin",
    "doc": "./docs",
    "lib": "./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qfliuyang/hipilot.git"
  },
  "bugs": {
    "url": "https://github.com/qfliuyang/hipilot/issues"
  },
  "homepage": "https://github.com/qfliuyang/hipilot#readme",
  "publishConfig": {
    "access": "public"
  }
}
